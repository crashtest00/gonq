{
  "name": "@gonq/editor",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "The shareable Gonq frontend: CodeMirror editor, comment-threads library, platform seam over the generated bindings, command registry and feature modules. Consumed as TypeScript source by apps/desktop.",
  "exports": {
    "./agent-skill/SKILL.md": "./src/agent-skill/SKILL.md",
    "./commands": "./src/commands/index.ts",
    "./controllers/commentBox": "./src/controllers/commentBox.ts",
    "./controllers/document": "./src/controllers/document.ts",
    "./controllers/github": "./src/controllers/github.ts",
    "./controllers/repoTree": "./src/controllers/repoTree.ts",
    "./controllers/signIn": "./src/controllers/signIn.ts",
    "./controllers/threadEdits": "./src/controllers/threadEdits.ts",
    "./comment-threads": "./src/comment-threads/index.ts",
    "./dialogs/DialogHost": "./src/dialogs/DialogHost.tsx",
    "./editor/MarkdownEditor": "./src/editor/MarkdownEditor.tsx",
    "./editor/MarkdownPreview": "./src/editor/MarkdownPreview.tsx",
    "./editor/tableTools": "./src/editor/tableTools.tsx",
    "./features/comments": "./src/features/comments/index.ts",
    "./features/edit": "./src/features/edit/index.ts",
    "./features/file": "./src/features/file/index.ts",
    "./features/format": "./src/features/format/index.ts",
    "./features/github": "./src/features/github/index.ts",
    "./features/help": "./src/features/help/index.ts",
    "./features/insert": "./src/features/insert/index.ts",
    "./features/view": "./src/features/view/index.ts",
    "./package.json": "./package.json",
    "./setupTests": "./src/setupTests.ts",
    "./styles/editor.css": "./src/styles/editor.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./agent-skill/*": "./src/agent-skill/*.ts",
    "./agent-skill/fixtures/*": "./src/agent-skill/fixtures/*",
    "./commands/*": "./src/commands/*.ts",
    "./comment-threads/*": "./src/comment-threads/*.ts",
    "./comment-threads/editor/*": "./src/comment-threads/editor/*.ts",
    "./document/*": "./src/document/*.ts",
    "./editor/*": "./src/editor/*.ts",
    "./features/comments/*": "./src/features/comments/*.ts",
    "./features/edit/*": "./src/features/edit/*.ts",
    "./features/file/*": "./src/features/file/*.ts",
    "./features/format/*": "./src/features/format/*.ts",
    "./features/github/*": "./src/features/github/*.ts",
    "./features/help/*": "./src/features/help/*.ts",
    "./features/insert/*": "./src/features/insert/*.ts",
    "./features/view/*": "./src/features/view/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./model/*": "./src/model/*.ts",
    "./platform/app": "./src/platform/app.ts",
    "./platform/*": "./src/platform/*.ts",
    "./testing/*": "./src/testing/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.8.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
