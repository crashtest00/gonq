{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the mobile main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "gonq:default",
    "gonq-saf:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/crashtest00/gonq" }, { "url": "https://github.com/login/device" }, { "url": "https://github.com/*/pull/*" }]
    }
  ]
}
